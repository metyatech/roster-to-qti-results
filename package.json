{
  "name": "roster-to-qti-results",
  "private": false,
  "type": "module",
  "version": "0.1.1",
  "description": "Generate QTI 3.0 Results Reporting XML from roster CSV files.",
  "repository": {
    "type": "git",
    "url": "https://github.com/metyatech/roster-to-qti-results.git"
  },
  "homepage": "https://github.com/metyatech/roster-to-qti-results",
  "bugs": {
    "url": "https://github.com/metyatech/roster-to-qti-results/issues"
  },
  "author": "metyatech",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "roster-to-qti-results": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm audit && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test": "tsx test/run-tests.ts",
    "roster-to-qti-results": "tsx src/cli.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "csv-parse": "^5.5.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.54.0"
  },
  "overrides": {
    "ajv": "^6.14.0",
    "minimatch": "^10.2.1"
  },
  "lint-staged": {
    "**/*.ts": [
      "prettier --check",
      "eslint"
    ],
    "*.{json,md}": [
      "prettier --check"
    ]
  }
}
